<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AionMeter.Core\AionMeter.Core.csproj" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CatScratch</AssemblyName>
    <RootNamespace>AionMeter.App</RootNamespace>
    <Product>CatScratch</Product>
    <AssemblyTitle>CatScratch</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>3.0.1-beta.21</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, Brush... keep WinForms explicit (tray icon only). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <None Update="Assets\Sounds\*.wav" Link="sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\**\*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Launcher\**\*.cs" />
    <Content Include="$(BaseIntermediateOutputPath)game-launcher\CatScratch.GameWatcher.exe" Link="CatScratch.GameWatcher.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildGameWatcherLauncher" BeforeTargets="PrepareForBuild" Inputs="$(MSBuildProjectDirectory)\Launcher\GameWatcherLauncher.cs" Outputs="$(BaseIntermediateOutputPath)game-launcher\CatScratch.GameWatcher.exe">
    <MakeDir Directories="$(BaseIntermediateOutputPath)game-launcher" />
    <Exec Command="&quot;$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:winexe /optimize+ /out:&quot;$(BaseIntermediateOutputPath)game-launcher\CatScratch.GameWatcher.exe&quot; &quot;$(MSBuildProjectDirectory)\Launcher\GameWatcherLauncher.cs&quot;" />
  </Target>

</Project>
