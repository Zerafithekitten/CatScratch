<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:colors="clr-namespace:AionMeter.App.Services">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="MeterPreferences.xaml"/></ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="Bg0" Color="{colors:ThemeColor #20242A}"/>
    <SolidColorBrush x:Key="Bg1" Color="{colors:ThemeColor #191D23}"/>
    <SolidColorBrush x:Key="Gold" Color="{colors:ThemeColor #C49AF5}"/>
    <SolidColorBrush x:Key="GoldDim" Color="{colors:ThemeColor #414A56}"/>
    <SolidColorBrush x:Key="Text" Color="{colors:ThemeColor #EDF2F7}"/>
    <SolidColorBrush x:Key="TextDim" Color="{colors:ThemeColor #BCC9D6}"/>
    <SolidColorBrush x:Key="TextMute" Color="{colors:ThemeColor #A9B8C7}"/>
    <FontFamily x:Key="TitleFont">Segoe UI</FontFamily>
    <Style x:Key="ReleaseTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource CustomBrush_BCC9D6}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Surface" Background="{DynamicResource CustomBrush_191D23}" BorderBrush="{DynamicResource CustomBrush_414A56}" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="0,0,5,5">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CustomBrush_2B3038}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CustomBrush_30333D}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CustomBrush_C49AF5}"/><Setter Property="Foreground" Value="{DynamicResource CustomBrush_C49AF5}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CustomBrush_C49AF5}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Margin="4" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CustomBrush_262C34}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CustomBrush_C49AF5}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CustomBrush_262C34}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
