<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="MeterPreferences.xaml"/></ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="Bg0" Color="#1B2027"/>
    <SolidColorBrush x:Key="Bg1" Color="#171E27"/>
    <SolidColorBrush x:Key="Gold" Color="#79E3CF"/>
    <SolidColorBrush x:Key="GoldDim" Color="#364957"/>
    <SolidColorBrush x:Key="Text" Color="#EDF2F7"/>
    <SolidColorBrush x:Key="TextDim" Color="#BCC9D6"/>
    <SolidColorBrush x:Key="TextMute" Color="#A9B8C7"/>
    <FontFamily x:Key="TitleFont">Segoe UI</FontFamily>
    <Style x:Key="ReleaseTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#BCC9D6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Surface" Background="#171E27" BorderBrush="#364957" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="0,0,5,5">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#24313A"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#263C3D"/><Setter TargetName="Surface" Property="BorderBrush" Value="#79E3CF"/><Setter Property="Foreground" Value="#79E3CF"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#79E3CF"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Margin="4" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#202A35"/><Setter TargetName="Surface" Property="BorderBrush" Value="#79E3CF"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#202A35"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
