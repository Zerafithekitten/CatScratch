<Window x:Class="AionMeter.App.Windows.BreakdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:colors="clr-namespace:AionMeter.App.Services"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="Breakdown — CatScratch" Width="1040" Height="720" MinWidth="900" MinHeight="480"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{StaticResource Bg0}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme/MeterPreferences.xaml" /></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Bg0" Color="{colors:ThemeColor #20242A}"/>
        <SolidColorBrush x:Key="Bg1" Color="{colors:ThemeColor #191D23}"/>
        <SolidColorBrush x:Key="Line" Color="{colors:ThemeColor #414A56}"/>
        <SolidColorBrush x:Key="Gold" Color="{colors:ThemeColor #C49AF5}"/>
        <SolidColorBrush x:Key="GoldDim" Color="{colors:ThemeColor #414A56}"/>
        <SolidColorBrush x:Key="Text" Color="{colors:ThemeColor #EDF2F7}"/>
        <SolidColorBrush x:Key="TextDim" Color="{colors:ThemeColor #BCC9D6}"/>
        <SolidColorBrush x:Key="TextMute" Color="{colors:ThemeColor #A9B8C7}"/>
        <FontFamily x:Key="TitleFont">Segoe UI</FontFamily>
        <Style x:Key="TabToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource CustomBrush_A9B8C7}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" Background="Transparent" Padding="14,8" Margin="0,0,5,0" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource CustomBrush_C49AF5}"/><Setter TargetName="Tab" Property="Background" Value="{DynamicResource CustomBrush_30333D}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource CustomBrush_2B3038}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <c:VisibleIf x:Key="VisibleIf" />

        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CustomBrush_191D23}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CustomBrush_414A56}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <!-- A column header that sorts its table: gold when it is the sort column, brighter under the mouse. -->
        <Style x:Key="ThButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
            <EventSetter Event="Click" Handler="SortHead_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="3,2">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{StaticResource NumberFont}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Td" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Party list -->
            <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Image Source="{x:Static s:AppIcon.Image}" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="CatScratch" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Gold}" /></StackPanel>
                        <Border Background="{DynamicResource CustomBrush_262C34}" CornerRadius="7" Padding="9" Margin="0,8,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:BossPortrait x:Name="FightPortrait" Width="32" Height="32" Accent="{StaticResource Gold}" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="FightTitle" FontSize="12" Foreground="{StaticResource Text}"
                                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                <TextBlock x:Name="FightMeta" FontFamily="{StaticResource NumberFont}" FontSize="10.5"
                                           Foreground="{StaticResource TextMute}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid></Border>
                    </StackPanel>
                    <ListBox x:Name="PartyList" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" Margin="6,0,6,6"
                             SelectionChanged="PartyList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="7" Padding="8,9" Margin="0,3" Background="{DynamicResource CustomBrush_262C34}" BorderBrush="Transparent" BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CustomBrush_30333D}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CustomBrush_C49AF5}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="19" Height="19" CornerRadius="5" HorizontalAlignment="Left" Background="{Binding Rank.Bg}"
                                            BorderBrush="{Binding Rank.Border}" BorderThickness="1">
                                        <TextBlock Text="{Binding PlaceText}" FontFamily="{StaticResource NumberFont}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding Rank.Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <c:ClassGlyph Grid.Column="1" Class="{Binding Class}" Width="19" Height="19" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5" Foreground="{Binding NameBrush}"
                                               FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding ShareText}" FontFamily="{StaticResource NumberFont}" FontSize="11"
                                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="132" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Identity and actions above a separate row of summary cards. -->
                <Grid Margin="16,8,8,10">
                    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <c:ClassGlyph x:Name="HeaderGlyph" Width="36" Height="36" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PlayerName" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PlayerMeta" FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,2,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="CompareBoss" Style="{StaticResource IconButton}" Content="&#xE8AB;" Click="CompareBoss_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BD;" Click="CopyChat_Click" ToolTip="{Binding TipChat, Source={x:Static s:UiText.Current}}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="CopyImage_Click" ToolTip="{Binding TipCopyImage, Source={x:Static s:UiText.Current}}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{Binding TipMinimize, Source={x:Static s:UiText.Current}}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}"/>
                        </StackPanel>
                    </Grid>
                    <UniformGrid Grid.Row="1" Rows="1" Margin="0,6,0,0">
                        <Border x:Name="PlaceTile" Style="{StaticResource StatTile}"><StackPanel><TextBlock x:Name="PlaceLabel" Text="{Binding TilePlace, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}"/><TextBlock x:Name="StatPlace" Style="{StaticResource TileValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="{Binding TileDamage, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}"/><TextBlock x:Name="StatDamage" Style="{StaticResource TileValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="{Binding TileDps, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}"/><TextBlock x:Name="StatDps" Style="{StaticResource TileValue}" Foreground="{StaticResource GoldBright}"/></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="{Binding TileContrib, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}"/><TextBlock x:Name="StatShare" Style="{StaticResource TileValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource StatTile}"><StackPanel><TextBlock Text="{Binding TileTime, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}"/><TextBlock x:Name="StatTime" Style="{StaticResource TileValue}"/></StackPanel></Border>
                    </UniformGrid>
                </Grid>
                <!-- Tabs -->
                <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="12,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabDps" Style="{StaticResource TabToggle}" Content="{Binding TabDps, Source={x:Static s:UiText.Current}}" IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabAccuracy" Style="{StaticResource TabToggle}" Content="{Binding TabAccuracy, Source={x:Static s:UiText.Current}}" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabRotation" Style="{StaticResource TabToggle}" Content="{Binding TabRotation, Source={x:Static s:UiText.Current}}" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabDefense" Style="{StaticResource TabToggle}" Content="{Binding TabDefense, Source={x:Static s:UiText.Current}}" Checked="Tab_Checked" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" x:Name="Body" Margin="16,12,16,14">
                    <!-- DPS -->
                    <Grid x:Name="PageDps">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="176" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border CornerRadius="8" Background="{DynamicResource CustomBrush_191D23}" BorderBrush="{DynamicResource CustomBrush_414A56}" BorderThickness="1" Padding="6,10,10,4">
                            <Grid>
                                <TextBlock Text="{Binding DpsTimeline, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="8,0,0,0" />
                                <c:TimelineChart x:Name="Chart" Margin="0,14,0,0" />
                            </Grid>
                        </Border>
                        <Grid x:Name="SkillHead" Grid.Row="1" Margin="8,12,14,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Button Tag="Name" Style="{StaticResource ThButton}" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Tag="Hits" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="2" Tag="Damage" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="3" Tag="Dps" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="4" Tag="Average" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="5" Tag="Max" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="6" Tag="Crit" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="7" Tag="Share" Style="{StaticResource ThButton}" />
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SkillList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="36" Margin="0,0,0,4" ToolTip="{Binding Tooltip}">
                                            <Border CornerRadius="7" Background="{DynamicResource CustomBrush_262C34}" />
                                            <Grid Margin="8,0,14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Grid Width="22" Height="22"><Border CornerRadius="4" Background="{Binding Swatch}" /><Image Source="{Binding Icon}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,22,22" RadiusX="4" RadiusY="4" /></Image.Clip></Image></Grid>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DotTag}" Margin="6,0,0,0" FontSize="10" Foreground="{StaticResource TextMute}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Hits}" Style="{StaticResource Td}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Damage}" Style="{StaticResource Td}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="3" Text="{Binding Dps}" Style="{StaticResource Td}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Avg}" Style="{StaticResource Td}" Foreground="{StaticResource TextDim}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Max}" Style="{StaticResource Td}" Foreground="{StaticResource TextDim}" />
                                                <TextBlock Grid.Column="6" Text="{Binding Crit}" Style="{StaticResource Td}" />
                                                <Grid Grid.Column="7" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <Border Height="5" CornerRadius="2.5" Background="{DynamicResource CustomBrush_22FFFFFF}" />
                                                    <Border Height="5" CornerRadius="2.5" Background="{StaticResource Gold}" HorizontalAlignment="Left"
                                                            Width="{Binding ShareWidth}" />
                                                    <TextBlock Text="{Binding Share}" Style="{StaticResource Td}" FontSize="10.5" Margin="0,-16,0,0"
                                                               Foreground="{StaticResource TextDim}" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Accuracy -->
                    <Grid x:Name="PageAccuracy" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <UniformGrid x:Name="QualityTiles" Columns="4" Rows="2" />
                        <Grid x:Name="AccuracyHead" Grid.Row="1" Margin="8,16,14,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <Button Tag="Name" Style="{StaticResource ThButton}" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Tag="Hits" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="2" Tag="Crit" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="3" Tag="Back" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="4" Tag="Front" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="5" Tag="Perfect" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="6" Tag="Heavy" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="7" Tag="Multi" Style="{StaticResource ThButton}" />
                            <Button Grid.Column="8" Tag="Damage" Style="{StaticResource ThButton}" />
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AccuracyList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34" Margin="0,0,0,4">
                                            <Border CornerRadius="7" Background="{DynamicResource CustomBrush_262C34}" />
                                            <Grid Margin="8,0,14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="68" />
                                                </Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid Width="18" Height="18"><Border CornerRadius="4" Background="{Binding Swatch}" /><Image Source="{Binding Icon}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,18,18" RadiusX="4" RadiusY="4" /></Image.Clip></Image></Grid>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Hits}" Style="{StaticResource Td}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Crit}" Style="{StaticResource Td}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Back}" Style="{StaticResource Td}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Front}" Style="{StaticResource Td}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Perfect}" Style="{StaticResource Td}" />
                                                <TextBlock Grid.Column="6" Text="{Binding Heavy}" Style="{StaticResource Td}" />
                                                <TextBlock Grid.Column="7" Text="{Binding Multi}" Style="{StaticResource Td}" />
                                                <TextBlock Grid.Column="8" Text="{Binding Damage}" Style="{StaticResource Td}" Foreground="{StaticResource TextDim}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Rotation -->
                    <Grid x:Name="PageRotation" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border x:Name="RotationWarning" Background="{StaticResource Bg1}" BorderBrush="#806C5940" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="!" Foreground="#F5B544" FontSize="30" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="WORK IN PROGRESS" Foreground="{StaticResource Text}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="RotationHint" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,0,0,10"
                                       Text="{Binding RotationHint, Source={x:Static s:UiText.Current}}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <c:RotationStrip x:Name="Rotation" Margin="0,0,8,0" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Defense -->
                    <StackPanel x:Name="PageDefense" Visibility="Collapsed">
                        <UniformGrid x:Name="DefenseTiles" Rows="1" Margin="-6,0,0,0" HorizontalAlignment="Left" />
                        <TextBlock Margin="0,16,0,0" Foreground="{StaticResource TextMute}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="{Binding DefNote, Source={x:Static s:UiText.Current}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
