<Window x:Class="AionMeter.App.Windows.BossTimersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:colors="clr-namespace:AionMeter.App.Services"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding TimersTitle, Source={x:Static s:UiText.Current}}" Width="780" Height="640" MinWidth="600" MinHeight="300"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{DynamicResource CustomBrush_20242A}"
        Topmost="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Theme/MeterPreferences.xaml" /></ResourceDictionary.MergedDictionaries>
            <c:VisibleIf x:Key="VisibleIf" />
            <SolidColorBrush x:Key="Gold" Color="{colors:ThemeColor #C49AF5}" />
            <SolidColorBrush x:Key="GoldDim" Color="{colors:ThemeColor #414A56}" />
            <SolidColorBrush x:Key="TextMute" Color="{colors:ThemeColor #A9B8C7}" />
            <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Padding" Value="8,4" /><Setter Property="Foreground" Value="{DynamicResource CustomBrush_EDF2F7}" /></Style>
            <Style x:Key="TabToggle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource CustomBrush_A9B8C7}" /><Setter Property="Padding" Value="10,6" /><Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tab" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent"><ContentPresenter /></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource CustomBrush_C49AF5}" /><Setter TargetName="Tab" Property="Background" Value="{DynamicResource CustomBrush_30333D}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource CustomBrush_262C34}" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="BossShell" Background="{DynamicResource CustomBrush_20242A}" BorderBrush="#60616A76" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{x:Static s:AppIcon.Image}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding TimersTitle, Source={x:Static s:UiText.Current}}" Foreground="{DynamicResource CustomBrush_C49AF5}"
                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <!-- Every server runs its own bosses: whose timers these are -->
                    <Button x:Name="ServerButton" Style="{StaticResource Chip}" Height="26" FontSize="12" Margin="14,0,0,0"
                            VerticalAlignment="Center" Click="Server_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{Binding TipServer, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Visibility="Collapsed" Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" Margin="0,1,6,0" />
                    <TextBlock Visibility="Collapsed" Text="{Binding AlertLabel, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Visibility="Collapsed" x:Name="AlertButton" Style="{StaticResource Chip}" Height="26" MinWidth="78" FontSize="12" Margin="0,0,10,0"
                            Click="Alert_Click" />
                    <ContentControl x:Name="PositionPin"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click"
                            ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,0,18,10">
                <StackPanel Orientation="Horizontal" Margin="-4,0,0,6">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource TabToggle}" IsChecked="True" Checked="Filter_Changed"
                                 Content="{Binding FilterAll, Source={x:Static s:UiText.Current}}" />
                    <RadioButton x:Name="FilterWatched" Style="{StaticResource TabToggle}" Checked="Filter_Changed"
                                 Content="{Binding FilterWatched, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMute}"
                           Text="{Binding TimersHint, Source={x:Static s:UiText.Current}}" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,12">
                <Grid>
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CustomBrush_191D23}" BorderBrush="{Binding FrameBrush}" BorderThickness="1" CornerRadius="7"
                                        Padding="10,8" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <c:BossPortrait Width="40" Height="40" Source="{Binding Portrait}" Accent="{StaticResource Gold}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextMute}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Width="150" Margin="0,0,12,0" VerticalAlignment="Center"
                                                    Background="Transparent" ToolTip="{Binding SourceTip}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource NumberFont}" FontSize="{Binding StatusSize}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding StatusDetail}" HorizontalAlignment="Right" FontSize="11"
                                                       Foreground="{StaticResource TextDim}" Margin="0,-1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Style="{StaticResource Chip}" Height="26" MinWidth="96" FontSize="12"
                                                Margin="0,0,8,0" VerticalAlignment="Center" Click="Respawn_Click" ToolTip="{Binding RespawnTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,6,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RespawnLabel}" VerticalAlignment="Center" />
                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="6,2,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <ToggleButton Grid.Column="4" Style="{StaticResource IconToggle}" Content="&#xEA8F;" VerticalAlignment="Center"
                                                      IsChecked="{Binding Watch, Mode=OneWay}" Click="Watch_Click" Margin="0,0,4,0"
                                                      ToolTip="{Binding TipWatch, Source={x:Static s:UiText.Current}}" />
                                        <Button Grid.Column="5" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                Content="{Binding BtnKilled, Source={x:Static s:UiText.Current}}" Click="Killed_Click"
                                                ToolTip="{Binding TipKilled, Source={x:Static s:UiText.Current}}" />
                                        <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE74D;" VerticalAlignment="Center"
                                                Click="Remove_Click" ToolTip="{Binding TipRemoveTimer, Source={x:Static s:UiText.Current}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyText" Text="{Binding TimersEmpty, Source={x:Static s:UiText.Current}}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMute}" HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="30,40,30,0" MaxWidth="380" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
