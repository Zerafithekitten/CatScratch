<Window x:Class="AionMeter.App.Windows.DeathRecapWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" MinWidth="260" SizeToContent="Height" MaxHeight="420" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="Transparent" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Theme/MeterTools.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Border x:Name="Shell" Background="#F01B2027" BorderBrush="#364957" BorderThickness="1" CornerRadius="8" Padding="9">
        <StackPanel>
            <DockPanel Margin="0,0,0,5"><Image x:Name="Paw" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock x:Name="Heading" Foreground="#79E3CF" FontWeight="SemiBold" FontSize="13"/></DockPanel>
            <TextBlock x:Name="Summary" Foreground="#BCC9D6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <TextBlock x:Name="Sources" Foreground="#EDF2F7" FontSize="11" MaxHeight="42" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,5" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="Hits"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="#171E27" CornerRadius="4" Padding="5,3" Margin="0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" Foreground="#A9B8C7" FontSize="10" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="3,0,6,0"><TextBlock Text="{Binding Enemy}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Enemy}"/><TextBlock Text="{Binding Skill}" Foreground="#A9B8C7" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Skill}"/></StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Damage}" Foreground="#79E3CF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding Details}"/>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="Hint" FontSize="10" Foreground="#A9B8C7" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
