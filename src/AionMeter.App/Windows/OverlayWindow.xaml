<Window x:Class="AionMeter.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:vm="clr-namespace:AionMeter.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="Root"
        Title="AION 2 • DPS Monitor — EU/NA" Width="380" Height="340" MinWidth="280" MinHeight="180"
        WindowStyle="None" AllowsTransparency="False" Background="#101420"
        Topmost="True" ShowInTaskbar="True" ShowActivated="True" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <c:VisibleIf x:Key="VisibleIf" />

        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
        </Storyboard>

        <!-- Row size (Settings → Overlay → Row size, Ctrl + wheel over the rows): OverlayWindow.ApplyRowSize replaces
             these. The value columns are as wide as their widest value (shared size groups across the rows), so the name
             gets all the room that is left. -->
        <GridLength x:Key="ColRankWidth">20</GridLength>
        <GridLength x:Key="ColGlyphWidth">26</GridLength>
        <Thickness x:Key="ColGap">10,0,0,0</Thickness>
        <sys:Double x:Key="NameMaxWidth">220</sys:Double>
        <sys:Double x:Key="RowHeight">28</sys:Double>
        <sys:Double x:Key="CompactNameFont">12</sys:Double>
        <sys:Double x:Key="CompactSubFont">11</sys:Double>
        <sys:Double x:Key="CompactNumberFont">11.5</sys:Double>
        <Thickness x:Key="RowMargin">0,0,0,3</Thickness>
        <sys:Double x:Key="RowNameFont">13.5</sys:Double>
        <sys:Double x:Key="RowGearFont">12</sys:Double>
        <sys:Double x:Key="RowNumberFont">13.5</sys:Double>
        <sys:Double x:Key="RowSubFont">12</sys:Double>
        <sys:Double x:Key="RowGlyphSize">20</sys:Double>
        <sys:Double x:Key="RowRankFont">11</sys:Double>
        <sys:Double x:Key="RowAccentWidth">3</sys:Double>

        <!-- A soft dark halo under every text so it stays readable over any game scene -->
        <DropShadowEffect x:Key="TextShadow" BlurRadius="2" ShadowDepth="1" Direction="300" Opacity="0.9" Color="Black" />

        <!-- DPS: the figure that matters, white and a little bolder -->
        <Style x:Key="RowNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowNumberFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="{DynamicResource ColGap}" />
        </Style>

        <!-- Total damage and share: smaller and softer than the DPS -->
        <Style x:Key="RowSub" TargetType="TextBlock" BasedOn="{StaticResource RowNumber}">
            <Setter Property="FontSize" Value="{DynamicResource RowSubFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#EDF2F7" />
        </Style>

        <!-- Gear score and combat power: "GS 2822  CP 50.5K" — a light label and a bold coloured value, one size and one
             baseline, no box (a box crowds a slim row); the row's text shadow keeps them readable on any class colour -->
        <Style x:Key="GearText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowGearFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,1" />
        </Style>

        <!-- The hover toolbar's buttons, sized to the slim top line -->
        <Style x:Key="ToolIcon" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <SolidColorBrush x:Key="Cream" Color="#F3E6C8" />
        <SolidColorBrush x:Key="Soft" Color="#C3CAD8" />
        <SolidColorBrush x:Key="SelfGold" Color="#F2C25A" />

        <!-- A hairline frame, a touch lighter at the top -->
        <LinearGradientBrush x:Key="CardFrame" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0" />
            <GradientStop Color="#1AFFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HpFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#B9303A" Offset="0" />
            <GradientStop Color="#EE5A5E" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="FooterLink" TargetType="Button">
            <Setter Property="Foreground" Value="#C9A964" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="P" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFE3A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The footer's boss timer button: a quiet outlined pill, still plainly a button -->
        <Style x:Key="TimersPill" TargetType="Button">
            <Setter Property="Foreground" Value="#F0D48E" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Padding="8,2,9,2" BorderThickness="1" BorderBrush="#66D9B56A" Background="#1AD9B56A">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D9B56A" />
                                <Setter TargetName="Bd" Property="Background" Value="#33D9B56A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "A new version is out": a slim green banner above the footer, only while an update is available -->
        <Style x:Key="UpdateBannerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D2FAE6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="9,3,9,3" BorderThickness="1" BorderBrush="#803DD68C" Background="#2A3DD68C">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3DD68C" />
                                <Setter TargetName="Bd" Property="Background" Value="#403DD68C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One player: a slim bar in the class colour fading out towards its tip, a strip of that colour at the left edge,
             the place, emblem, name with gear score and combat power, then DPS, total damage and share -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:RowViewModel}">
            <Grid Height="{DynamicResource RowHeight}" Margin="{DynamicResource RowMargin}" Cursor="Hand" ToolTip="{Binding Tooltip}"
                  Background="Transparent" MouseLeftButtonUp="Row_Click" MouseRightButtonUp="Row_RightClick">
                <!-- track -->
                <Border x:Name="Track" CornerRadius="4" Background="#14FFFFFF" />
                <!-- fill -->
                <Border CornerRadius="4" Background="{Binding FillBrush}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Fill}" />
                    </Border.RenderTransform>
                </Border>
                <!-- class strip -->
                <Border Width="{DynamicResource RowAccentWidth}" HorizontalAlignment="Left" CornerRadius="4,0,0,4" Background="{Binding AccentBrush}" />
                <!-- your own row -->
                <Border CornerRadius="4" BorderThickness="1" BorderBrush="#B3F2C25A"
                        Visibility="{Binding IsSelf, Converter={StaticResource VisibleIf}}" />

                <Grid Margin="8,0,10,0" Effect="{StaticResource TextShadow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource ColRankWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColGlyphWidth}" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Gs" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Cp" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Dps" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Damage" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Share" />
                    </Grid.ColumnDefinitions>

                    <!-- Place: plain digits, the top three in medal colours -->
                    <TextBlock Text="{Binding RankText}" FontFamily="{StaticResource NumberFont}" FontSize="{DynamicResource RowRankFont}"
                               FontWeight="Bold" Foreground="{Binding RankColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <c:ClassGlyph Grid.Column="1" Class="{Binding Class}" OnBar="True" Width="{DynamicResource RowGlyphSize}"
                                  Height="{DynamicResource RowGlyphSize}" HorizontalAlignment="Left" />

                    <!-- As wide as the longest name, up to what the other columns leave (OverlayWindow.FitNames) -->
                    <TextBlock x:Name="NameText" Grid.Column="2" FontSize="{DynamicResource RowNameFont}" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,0,1"
                               MaxWidth="{DynamicResource NameMaxWidth}"><Run Text="{Binding Name, Mode=OneWay}" /><LineBreak /><Run Text="{Binding Class, Mode=OneWay}" FontSize="11" Foreground="#C4CBD8" /></TextBlock>

                    <!-- Gear score and combat power, right by the name: only players of your party have them (the party roster) -->
                    <TextBlock Grid.Column="3" Style="{StaticResource GearText}" Visibility="{Binding HasGearScore, Converter={StaticResource VisibleIf}}"
                               ToolTip="{Binding DataContext.T.TipGs, RelativeSource={RelativeSource AncestorType=Window}}"><Run Text="GS " FontWeight="SemiBold" Foreground="#D5DAE4" /><Run Text="{Binding GearScore, Mode=OneWay}" Foreground="#FFD873" /></TextBlock>
                    <TextBlock Grid.Column="4" Style="{StaticResource GearText}" Visibility="{Binding HasCombatPower, Converter={StaticResource VisibleIf}}"
                               ToolTip="{Binding DataContext.T.TipCp, RelativeSource={RelativeSource AncestorType=Window}}"><Run Text="CP " FontWeight="SemiBold" Foreground="#D5DAE4" /><Run Text="{Binding CombatPower, Mode=OneWay}" Foreground="#8FDBFF" /></TextBlock>

                    <TextBlock Grid.Column="6" Text="{Binding Dps}" Style="{StaticResource RowNumber}" />
                    <TextBlock Grid.Column="7" Text="{Binding Damage}" Style="{StaticResource RowSub}" />
                    <TextBlock Grid.Column="8" Text="{Binding Share}" Style="{StaticResource RowSub}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="#26FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource SelfGold}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <c:CompactFillClip x:Key="CompactFillClip"/>
        <DataTemplate x:Key="CompactRowTemplate" DataType="{x:Type vm:RowViewModel}">
            <Grid x:Name="CompactRow" Height="{DynamicResource CompactRowHeight}" Margin="0,0,0,2" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tooltip}" MouseLeftButtonUp="Row_Click" MouseRightButtonUp="Row_RightClick">
                <Border Background="#60202A32" CornerRadius="3"/>
                <Border Background="{Binding FillBrush}" Opacity="0.76" CornerRadius="3" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="{Binding Fill}"/></Border.RenderTransform></Border>
                <Grid Margin="4,1,5,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/><ColumnDefinition Width="61"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <c:ClassGlyph Class="{Binding Class}" Width="20" Height="20" OnBar="True"/>
                    <StackPanel x:Name="CompactIdentity" Grid.Column="1" Margin="2,0,3,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="{DynamicResource CompactNameFont}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CompactGear}" FontSize="{DynamicResource CompactSubFont}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="2,0,3,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Clip>
                            <MultiBinding Converter="{StaticResource CompactFillClip}">
                                <Binding ElementName="CompactIdentity" Path="ActualWidth"/>
                                <Binding ElementName="CompactIdentity" Path="ActualHeight"/>
                                <Binding ElementName="CompactRow" Path="ActualWidth"/>
                                <Binding Path="Fill"/>
                            </MultiBinding>
                        </StackPanel.Clip>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding CompactTextBrush}" FontWeight="SemiBold" FontSize="{DynamicResource CompactNameFont}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CompactGear}" FontSize="{DynamicResource CompactSubFont}" FontWeight="SemiBold" Foreground="{Binding CompactTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Effect="{StaticResource TextShadow}">
                        <TextBlock Text="{Binding Dps}" FontSize="{DynamicResource CompactNumberFont}" FontWeight="Bold" Foreground="White" TextAlignment="Right"/>
                        <TextBlock Text="{Binding Damage}" FontSize="{DynamicResource CompactSubFont}" FontWeight="SemiBold" Foreground="White" TextAlignment="Right"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Effect="{StaticResource TextShadow}" Text="{Binding Share}" FontSize="{DynamicResource CompactSubFont}" FontWeight="Bold" Foreground="#72EDD0" TextAlignment="Right" VerticalAlignment="Top" Margin="3,2,0,0"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="OuterShell" CornerRadius="10" Background="#DF1B2027" BorderBrush="#607B827F" BorderThickness="1">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="24" Margin="5,1,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="ShellCaption" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/app.ico" Width="14" Height="14" Margin="0,0,5,0"/>
                <TextBlock Text="CatScratch" Foreground="#79E3CF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Clock, StringFormat=⏱ {0}}" Foreground="#91A5A0" FontSize="9" Margin="4,0" ToolTip="Fight duration" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding WallClock}" Foreground="#D4DAD9" FontSize="10" Margin="4,0" ToolTip="Current time · Europe/Berlin · 24-hour clock" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="ShellClickButton" Grid.Column="2" Style="{StaticResource ToolIcon}" Click="ClickMode_Click"><Grid Width="14" Height="14"><Path x:Name="ClickModeCursor" Data="M 2,1 L 12,8 L 7,8 L 5,13 Z" Fill="#79E3CF"/><Path x:Name="ClickModeSlash" Data="M 1,13 L 13,1" Stroke="#D9ADB1" StrokeThickness="2" Visibility="Collapsed"/></Grid></Button>
            <Button x:Name="ShellSettingsButton" Grid.Column="3" Style="{StaticResource ToolIcon}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings"/>
            <Button x:Name="ShellHideButton" Grid.Column="4" Style="{StaticResource ToolIcon}" Content="&#xE711;" Click="Hide_Click" ToolTip="Exit"/>
        </Grid>
    <Grid Margin="4,0,4,4">
        <!-- Card -->
        <Border x:Name="Frame" CornerRadius="14" BorderThickness="1" BorderBrush="#304C637F">
            <Border.Background>
                <SolidColorBrush x:Name="FrameBackground" Color="#0B0F17" Opacity="0.92" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="CardBody" Margin="5,4,5,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="SetupPanel" Background="#172333" BorderBrush="#405571" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                <DockPanel>
                    <Button x:Name="NpcapDownloadButton" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="Download Npcap" Click="NpcapDownload_Click" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="IdentityStatusText" Foreground="#EED99A" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>

                </StackPanel>
            </Border>

            <!-- The one top line: the fight's title on the left (the toolbar while the mouse is over the overlay), the state
                 and the timer on the right -->
            <Grid x:Name="Header" Grid.Row="1" Background="Transparent" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#EEF0F5" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,10,0" Effect="{StaticResource TextShadow}" Background="Transparent"
                           MouseWheel="Title_MouseWheel" ToolTip="{Binding TitleTip}" />

                <StackPanel x:Name="Toolbar" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Button Style="{StaticResource Chip}" Content="{Binding ModeLabel}" Click="Mode_Click" Margin="0,0,5,0"
                            ToolTip="Boss only / everything you hit" />
                    <Button Visibility="Collapsed" Style="{StaticResource Chip}" Content="{Binding LanguageCode}" Click="Language_Click" Margin="0,0,5,0"
                            ToolTip="{Binding T.SwitchLanguage}" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE8BD;" Click="Chat_Click" ToolTip="{Binding T.TipChat}" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE121;" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" />
                    <Button x:Name="RestartButton" Style="{StaticResource ToolIcon}" Content="&#xE72C;" Click="Restart_Click" />
                    <ToggleButton x:Name="LockButton" Style="{StaticResource ToolToggle}" Click="Lock_Click" ToolTip="Lock position">
                        <TextBlock x:Name="LockGlyph" Text="&#xE785;" />
                    </ToggleButton>
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings" />
                    <Slider x:Name="OpacitySlider" Style="{StaticResource GoldSlider}" Width="52" Minimum="0.15" Maximum="1" Margin="5,0,3,0"
                            ValueChanged="Opacity_Changed" VerticalAlignment="Center" ToolTip="Background opacity" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE711;" Click="Hide_Click" ToolTip="Exit" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Effect="{StaticResource TextShadow}">
                    <!-- The game's time limit for this instance: stays in view while the toolbar shows, like the clock -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Background="Transparent"
                                ToolTip="{Binding LimitTip}" Visibility="{Binding HasLimit, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{Binding LimitBrush}"
                                   Margin="0,1,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LimitText}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{Binding LimitBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="LabelPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding HeaderBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PulseBegin" Storyboard="{StaticResource Pulse}" />
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PulseBegin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding HeaderLabel}" Foreground="{Binding HeaderBrush}" FontSize="9.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="HeaderClock" Text="{Binding WallClock}" ToolTip="Current time · Europe/Berlin · 24-hour clock" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="13.5"
                               Foreground="#EEF0F5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Clock, StringFormat=⏱ {0}}" Visibility="{Binding Visibility, ElementName=HeaderClock}" ToolTip="Fight duration" Foreground="#91A5A0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Boss HP: a slim bar -->
            <Grid Grid.Row="2" Height="16" Margin="0,5,0,0" Visibility="{Binding HasBoss, Converter={StaticResource VisibleIf}}">
                <Border CornerRadius="4" Background="#2A1418" />
                <Border CornerRadius="4" Background="{StaticResource HpFill}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding BossHpFraction}" />
                    </Border.RenderTransform>
                </Border>
                <Grid Margin="7,0">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.9" Color="Black" />
                    </Grid.Effect>
                    <TextBlock Text="{Binding BossHpText}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="10.5"
                               Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BossPercent}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="10.5"
                               Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- Party: the rows share their value column widths -->
            <Grid Grid.Row="3" Margin="0,7,0,0" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- No column labels (the numbers read by themselves: 738K/s, 14.58M, 22.5 %): this empty grid only tells
                     OverlayWindow.FitNames how wide the rows' columns are -->
                <Grid x:Name="ColumnLabels" Height="0" Margin="8,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource ColRankWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColGlyphWidth}" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Gs" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Cp" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Dps" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Damage" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Share" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <ScrollViewer x:Name="PlayerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Padding="8,0,7,0" Margin="-8,0,-7,0" PreviewMouseWheel="Rows_PreviewMouseWheel">
                    <ItemsControl x:Name="PlayerRows" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                </ScrollViewer>
                <TextBlock Grid.RowSpan="2" Text="{Binding T.EmptyParty}" FontSize="12"
                           Foreground="#6B7590" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding HasData, Converter={StaticResource VisibleIf}, ConverterParameter=!}" />
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="4" Margin="0,6,0,0">
                <!-- New version on GitHub: a slim banner until it is installed, skipped or closed for this session -->
                <Grid x:Name="UpdateBanner" Margin="0,0,0,6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource UpdateBannerButton}" Click="Update_Click" ToolTip="{Binding T.TipUpdate}">
                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Click="UpdateBannerClose_Click" Margin="4,0,8,0"
                            VerticalAlignment="Center" ToolTip="{Binding T.UpdateLater}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Status}">
                        <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" Margin="0,0,6,0" />
                        <TextBlock x:Name="CompactTotal" Text="{Binding PartyDps}" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource TextShadow}" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="LatencyText" Text="RTT —" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource TextShadow}" Foreground="#EDF2F7" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Estimated network RTT from captured game TCP acknowledgments. Includes server ACK delay; a local accelerator measures only its local connection. No probe packets are sent. A dash means no fresh sample."/>
                        <TextBlock x:Name="FooterText" FontSize="11" Foreground="#A9B1C0" TextTrimming="CharacterEllipsis"
                                   Effect="{StaticResource TextShadow}" />
                    </StackPanel>
                    <StackPanel x:Name="FooterControls" Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button x:Name="ViewMenuButton" Style="{StaticResource FooterLink}" Content="View" Click="Appearance_Click" ToolTip="View"/>
                        <Button x:Name="EventsButton" Style="{StaticResource FooterLink}" Content="Events &amp; Timers" Click="Events_Click" ToolTip="Events &amp; Timers"/>
                        <Button x:Name="CompactHistory" Style="{StaticResource ToolIcon}" Content="&#xE8A5;" Click="Segments_Click" ToolTip="Statistics"/>
                        <Button Style="{StaticResource ToolIcon}" Content="&#xE8BD;" Click="Chat_Click" ToolTip="Copy fight damage (numbers + %)"/>
                        <Button Style="{StaticResource ToolIcon}" Content="&#xE8A1;" Click="PatchNotes_Click" ToolTip="Patch notes"/>
                        <Button x:Name="SaveLastFightButton" Style="{StaticResource ToolIcon}" Content="&#xE74E;" Click="SaveLastFight_Click" ToolTip="Save last fight" AutomationProperties.Name="Save last fight" />
                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource ToolIcon}" Content="&#xE895;" Click="CheckUpdates_Click" ToolTip="Check for updates" AutomationProperties.Name="Check for updates"/>
                        <!-- Boss timers: always visible, shows the next respawn -->
                        <Button x:Name="BossTimersLink" Style="{StaticResource TimersPill}" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE121;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TimersLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DetailsLink" Style="{StaticResource FooterLink}" Content="{Binding T.OpenFight}" Click="Details_Click" Effect="{StaticResource TextShadow}" />
                        <Button x:Name="HistoryLink" Style="{StaticResource FooterLink}" Click="Segments_Click" Effect="{StaticResource TextShadow}">
                            <TextBlock><Run Text="{Binding T.Fights, Mode=OneWay}" /><Run Text=" " /><Run Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" /></TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Resize grip -->
        <Thumb x:Name="ResizeGrip" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
               Cursor="SizeNWSE" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Path Data="M10 2 L2 10 M10 6 L6 10" Stroke="#59FFFFFF" StrokeThickness="1.2" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
    </DockPanel>
    </Border>
</Window>
