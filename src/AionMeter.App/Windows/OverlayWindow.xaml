<Window x:Class="AionMeter.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:colors="clr-namespace:AionMeter.App.Services"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:vm="clr-namespace:AionMeter.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="Root"
        Title="CatScratch" Width="420" Height="540" MinWidth="260" MinHeight="320"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource CustomBrush_191D23}"
        Topmost="True" ShowInTaskbar="True" ShowActivated="True" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <c:VisibleIf x:Key="VisibleIf" />
        <c:FractionWidth x:Key="FractionWidth" />
        <GridLength x:Key="DpsColumnWidth">76</GridLength><GridLength x:Key="ShareColumnWidth">57</GridLength>

        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
        </Storyboard>

        <!-- Row size (Settings → Overlay → Row size, Ctrl + wheel over the rows): OverlayWindow.ApplyRowSize replaces
             these. The value columns are as wide as their widest value (shared size groups across the rows), so the name
             gets all the room that is left. -->
        <GridLength x:Key="ColRankWidth">20</GridLength>
        <GridLength x:Key="ColGlyphWidth">26</GridLength>
        <Thickness x:Key="ColGap">10,0,0,0</Thickness>
        <sys:Double x:Key="NameMaxWidth">220</sys:Double>
        <sys:Double x:Key="RowHeight">28</sys:Double>
        <sys:Double x:Key="CompactNameFont">12</sys:Double>
        <sys:Double x:Key="CompactSubFont">11</sys:Double>
        <sys:Double x:Key="CompactNumberFont">11.5</sys:Double>
        <Thickness x:Key="RowMargin">0,0,0,3</Thickness>
        <sys:Double x:Key="RowNameFont">13.5</sys:Double>
        <sys:Double x:Key="RowGearFont">12</sys:Double>
        <sys:Double x:Key="RowNumberFont">13.5</sys:Double>
        <sys:Double x:Key="RowSubFont">12</sys:Double>
        <sys:Double x:Key="RowGlyphSize">20</sys:Double>
        <sys:Double x:Key="RowRankFont">11</sys:Double>
        <sys:Double x:Key="RowAccentWidth">3</sys:Double>

        <!-- A soft dark halo under every text so it stays readable over any game scene -->
        <DropShadowEffect x:Key="TextShadow" BlurRadius="2" ShadowDepth="1" Direction="300" Opacity="0.9" Color="Black" />

        <!-- DPS: the figure that matters, white and a little bolder -->
        <Style x:Key="RowNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowNumberFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="{DynamicResource ColGap}" />
        </Style>

        <!-- Total damage and share: smaller and softer than the DPS -->
        <Style x:Key="RowSub" TargetType="TextBlock" BasedOn="{StaticResource RowNumber}">
            <Setter Property="FontSize" Value="{DynamicResource RowSubFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CustomBrush_EDF2F7}" />
        </Style>

        <!-- Gear score and combat power: "GS 2822  CP 50.5K" — a light label and a bold coloured value, one size and one
             baseline, no box (a box crowds a slim row); the row's text shadow keeps them readable on any class colour -->
        <Style x:Key="GearText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowGearFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,1" />
        </Style>

        <!-- The hover toolbar's buttons, sized to the slim top line -->
        <Style x:Key="ToolIcon" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <SolidColorBrush x:Key="Cream" Color="#F3E6C8" />
        <SolidColorBrush x:Key="Soft" Color="#C3CAD8" />
        <SolidColorBrush x:Key="SelfGold" Color="#F2C25A" />

        <!-- A hairline frame, a touch lighter at the top -->
        <LinearGradientBrush x:Key="CardFrame" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{colors:ThemeColor #40FFFFFF}" Offset="0" />
            <GradientStop Color="{colors:ThemeColor #1AFFFFFF}" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HpFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#98414D" Offset="0" />
            <GradientStop Color="#D36470" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="FooterLink" TargetType="Button">
            <Setter Property="Foreground" Value="#C9A964" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="P" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFE3A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The footer's boss timer button: a quiet outlined pill, still plainly a button -->
        <Style x:Key="TimersPill" TargetType="Button">
            <Setter Property="Foreground" Value="#F0D48E" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Padding="8,2,9,2" BorderThickness="1" BorderBrush="#66D9B56A" Background="#1AD9B56A">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D9B56A" />
                                <Setter TargetName="Bd" Property="Background" Value="#33D9B56A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "A new version is out": a slim green banner above the footer, only while an update is available -->
        <Style x:Key="UpdateBannerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D2FAE6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="9,3,9,3" BorderThickness="1" BorderBrush="#803DD68C" Background="#2A3DD68C">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3DD68C" />
                                <Setter TargetName="Bd" Property="Background" Value="#403DD68C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CompactRowTemplate" DataType="{x:Type vm:RowViewModel}">
            <Grid x:Name="ModernRow" Height="{DynamicResource CompactRowHeight}" Margin="0,0,0,1" Cursor="Hand" Background="Transparent" ToolTip="{Binding Tooltip}" MouseLeftButtonUp="Row_Click" MouseRightButtonUp="Row_RightClick">
                <Border x:Name="RowSurface" Background="{DynamicResource CustomBrush_D0191D23}" BorderBrush="#302E4252" BorderThickness="1" CornerRadius="6" />
                <Border x:Name="RowFill" Background="{Binding AccentBrush}" Opacity="0.28" CornerRadius="6" RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fill}"/></Border.RenderTransform>
                </Border>
                <Grid Margin="6,1,6,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource ColGlyphWidth}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource DpsColumnWidth}"/><ColumnDefinition Width="{DynamicResource ShareColumnWidth}"/></Grid.ColumnDefinitions>
                    <c:ClassGlyph Class="{Binding Class}" Width="{DynamicResource RowGlyphSize}" Height="{DynamicResource RowGlyphSize}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Margin="4,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{DynamicResource DpsColumnWidth}"/><ColumnDefinition Width="{DynamicResource ShareColumnWidth}"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource CompactNameFont}" FontWeight="SemiBold" Foreground="{DynamicResource CustomBrush_EDF2F7}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CompactGear}" FontSize="{DynamicResource CompactSubFont}" Foreground="#ADBCCD" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Dps}" FontSize="{DynamicResource CompactNumberFont}" FontWeight="SemiBold" Foreground="{DynamicResource CustomBrush_EDF2F7}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding Share}" Foreground="{DynamicResource CustomBrush_C49AF5}" FontSize="{DynamicResource CompactNumberFont}" FontWeight="SemiBold" TextAlignment="Right" Margin="4,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DamageTaken}" Foreground="#FF8585" FontSize="{DynamicResource CompactSubFont}" FontWeight="SemiBold" TextAlignment="Right" ToolTip="{Binding DataContext.T.TipTaken, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource CustomBrush_60C49AF5}"/></Trigger>
                <DataTrigger Binding="{Binding DataContext.IsDisplayOnly, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource CustomBrush_B8191D23}"/>
                    <Setter TargetName="RowSurface" Property="BorderBrush" Value="Transparent"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="OuterShell" CornerRadius="10" BorderBrush="#60616A76" BorderThickness="1">
    <Border.Background><SolidColorBrush x:Name="ShellBackground" Color="{colors:ThemeColor #DF20242A}" Opacity="0.9"/></Border.Background>
    <DockPanel>
        <Grid x:Name="ShellHeader" DockPanel.Dock="Top" Height="38" Margin="8,2,6,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="ShellCaption" Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="ShellPaw" Source="/Assets/app.ico" Width="22" Height="22" Margin="0,0,7,0"/>
                <StackPanel VerticalAlignment="Center">
                    <c:CatWordmark x:Name="ShellTitle" Text="CatScratch" Foreground="{DynamicResource CustomBrush_C49AF5}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="InstalledVersionText" Text="{Binding Version}" FontSize="9" Foreground="{DynamicResource CustomBrush_A9B8C7}"/>
                </StackPanel>
                            <Button x:Name="PersonalCombatButton" Style="{StaticResource ToolIcon}" Content="&#xE95E;" Click="PersonalCombat_Click" ToolTip="{Binding T.Literal0}" AutomationProperties.Name="{Binding T.Literal1}" Margin="4,0,0,0" />
                            <Button x:Name="PetTrackerButton" Style="{StaticResource ToolIcon}" Click="PetTracker_Click" ToolTip="{Binding T.PetTrackerLabel}" Margin="2,0,0,0"><Image Source="/Assets/app.ico" Width="12" Height="12"/></Button>
</StackPanel>
            <StackPanel x:Name="ShellClockPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Clock, StringFormat=⏱ {0}}" Foreground="#A99CB8" FontSize="9" Margin="4,0" ToolTip="{Binding T.Literal2}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding WallClock}" Foreground="#D4DAD9" FontSize="10" Margin="4,0" ToolTip="{Binding T.Literal3}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="ShellClickButton" Grid.Column="2" Style="{StaticResource ToolIcon}" Click="ClickMode_Click"><Grid Width="12" Height="12"><Path x:Name="ClickModeCursor" Data="M 2,1 L 12,8 L 7,8 L 5,13 Z" Fill="{DynamicResource CustomBrush_C49AF5}"/><Path x:Name="ClickModeSlash" Data="M 1,13 L 13,1" Stroke="#D9ADB1" StrokeThickness="2" Visibility="Collapsed"/></Grid></Button>
            <Button x:Name="ShellSettingsButton" Grid.Column="3" Style="{StaticResource ToolIcon}" Content="&#xE713;" Click="Settings_Click" ToolTip="{Binding T.Literal4}"/>
            <ContentControl x:Name="ShellPin" Grid.Column="4" VerticalAlignment="Center"/>
            <Button x:Name="ShellHideButton" Grid.Column="5" Style="{StaticResource ToolIcon}" Content="&#xE711;" Click="Hide_Click" ToolTip="{Binding T.Literal5}"/>
        </Grid>
    <Grid Margin="4,0,4,4">
        <!-- Card -->
        <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
            <Border.Background>
                <SolidColorBrush x:Name="FrameBackground" Color="{colors:ThemeColor #191D23}" Opacity="0.92" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="CardBody" Margin="7,6,7,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="SetupPanel" Background="#172333" BorderBrush="#405571" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                <DockPanel>
                    <Button x:Name="NpcapDownloadButton" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="{Binding T.Literal6}" Click="NpcapDownload_Click" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="IdentityStatusText" Foreground="#EED99A" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>

                </StackPanel>
            </Border>

            <!-- The one top line: the fight's title on the left (the toolbar while the mouse is over the overlay), the state
                 and the timer on the right -->
            <Grid x:Name="Header" Grid.Row="1" Background="Transparent" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="MeterPinHost" Grid.Column="2" VerticalAlignment="Center" />

                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#EEF0F5" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,10,0" Effect="{StaticResource TextShadow}" Background="Transparent"
                           MouseWheel="Title_MouseWheel" ToolTip="{Binding TitleTip}" />

                <StackPanel x:Name="Toolbar" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Button x:Name="DamageModeButton" Style="{StaticResource Chip}" Content="{Binding ModeLabel}" Click="Mode_Click" Margin="0,0,5,0"
                            ToolTip="{Binding T.Literal7}" />
                    <Button Visibility="Collapsed" Style="{StaticResource Chip}" Content="{Binding LanguageCode}" Click="Language_Click" Margin="0,0,5,0"
                            ToolTip="{Binding T.SwitchLanguage}" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE8BD;" Click="Chat_Click" ToolTip="{Binding T.TipChat}" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE121;" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" />
                    <Button x:Name="RestartButton" Style="{StaticResource ToolIcon}" Content="&#xE72C;" Click="Restart_Click" />
                    <ToggleButton x:Name="LockButton" Style="{StaticResource ToolToggle}" Click="Lock_Click" ToolTip="{Binding T.Literal8}">
                        <TextBlock x:Name="LockGlyph" Text="&#xE785;" />
                    </ToggleButton>

                    <Slider x:Name="OpacitySlider" Style="{StaticResource GoldSlider}" Width="52" Minimum="0" Maximum="1" Margin="5,0,3,0"
                            ValueChanged="Opacity_Changed" VerticalAlignment="Center" ToolTip="{Binding T.Literal9}" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE711;" Click="Hide_Click" ToolTip="{Binding T.Literal5}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Effect="{StaticResource TextShadow}">
                    <!-- The game's time limit for this instance: stays in view while the toolbar shows, like the clock -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Background="Transparent"
                                ToolTip="{Binding LimitTip}" Visibility="{Binding HasLimit, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{Binding LimitBrush}"
                                   Margin="0,1,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LimitText}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{Binding LimitBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="LabelPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding HeaderBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PulseBegin" Storyboard="{StaticResource Pulse}" />
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PulseBegin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding HeaderLabel}" Foreground="{Binding HeaderBrush}" FontSize="9.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="HeaderClock" Text="{Binding WallClock}" ToolTip="{Binding T.Literal3}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="13.5"
                               Foreground="#EEF0F5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Clock, StringFormat=⏱ {0}}" Visibility="{Binding Visibility, ElementName=HeaderClock}" ToolTip="{Binding T.Literal2}" Foreground="#A99CB8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Rounded, unscaled HP fill with separate non-overlapping value columns. -->
            <Grid x:Name="BossHpPanel" Grid.Row="2" Margin="0,5,0,0" Visibility="{Binding HasBoss, Converter={StaticResource VisibleIf}}">
                <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border CornerRadius="5" Background="{DynamicResource CustomBrush_20242A}" BorderBrush="#805E3840" BorderThickness="1">
                    <Grid x:Name="BossHpTrack">
                        <Border x:Name="BossHpFill" CornerRadius="4" Background="{StaticResource HpFill}" HorizontalAlignment="Left">
                            <Border.Width><MultiBinding Converter="{StaticResource FractionWidth}"><Binding Path="ActualWidth" ElementName="BossHpTrack"/><Binding Path="BossHpFraction"/></MultiBinding></Border.Width>
                        </Border>
                        <Grid Margin="7,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding BossHpText}" ToolTip="{Binding BossHpText}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="10.5" Foreground="#FFF1F3" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding BossPercent}" Margin="8,0,0,0" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="10.5" Foreground="#FFF1F3" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
                <c:BossTimingView x:Name="InlineBossTiming" Grid.Row="1" Grid.RowSpan="2"/>
            </Grid>

            <!-- Party: the rows share their value column widths -->
            <Grid Grid.Row="3" Margin="0,7,0,0" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- No column labels (the numbers read by themselves: 738K/s, 14.58M, 22.5 %): this empty grid only tells
                     OverlayWindow.FitNames how wide the rows' columns are -->
                <Grid x:Name="ColumnLabels" Height="0" Margin="8,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource ColRankWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColGlyphWidth}" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Gs" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Cp" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Dps" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Damage" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Share" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <ScrollViewer x:Name="PlayerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Padding="8,0,7,0" Margin="-8,0,-7,0" PreviewMouseWheel="Rows_PreviewMouseWheel">
                    <ItemsControl x:Name="PlayerRows" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource CompactRowTemplate}" Focusable="False" />
                </ScrollViewer>
                <TextBlock Grid.RowSpan="2" Text="{Binding T.EmptyParty}" FontSize="12"
                           Foreground="{DynamicResource CustomBrush_6B7590}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding HasData, Converter={StaticResource VisibleIf}, ConverterParameter=!}" />
            </Grid>

            <StackPanel x:Name="PersonalSection" Grid.Row="4" Margin="0,5,0,0" Visibility="Collapsed">
                <Border x:Name="PersonalDivider" Height="1" Background="#403D5261" Margin="0,0,0,6"/>
                <Grid Height="22" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding T.Literal10}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource CustomBrush_EDF2F7}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PersonalName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#F2C25A" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="PersonalCollapseButton" Grid.Column="2" Style="{StaticResource ToolIcon}" Content="&#xE70E;" Click="PersonalCollapse_Click" ToolTip="{Binding T.Literal11}" Margin="5,0,0,0"/>
                </Grid>
                <StackPanel x:Name="PersonalMetrics"/>
            </StackPanel>
            <!-- Footer -->
            <StackPanel Grid.Row="5" Margin="0,6,0,0">
                <!-- New version on GitHub: a slim banner until it is installed, skipped or closed for this session -->
                <Grid x:Name="UpdateBanner" Margin="0,0,0,6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource UpdateBannerButton}" Click="Update_Click" ToolTip="{Binding T.TipUpdate}">
                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,7,0" VerticalAlignment="Center" />
                            <StackPanel><TextBlock x:Name="UpdateBannerText" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="UpdateActionText" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Click="UpdateBannerClose_Click" Margin="4,0,8,0"
                            VerticalAlignment="Center" ToolTip="{Binding T.UpdateLater}" />
                </Grid>
                <Grid x:Name="FooterLayout">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Status}">
                        <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" Margin="0,0,6,0" />
                        <TextBlock x:Name="CompactTotal" Text="{Binding PartyDps}" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource TextShadow}" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="LatencyText" Text="RTT —" FontSize="11" FontWeight="SemiBold" Effect="{StaticResource TextShadow}" Foreground="{DynamicResource CustomBrush_EDF2F7}" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="{Binding T.Literal12}"/>
                        <TextBlock x:Name="FooterText" FontSize="11" Foreground="#A9B1C0" TextTrimming="CharacterEllipsis"
                                   Effect="{StaticResource TextShadow}" />
                    </StackPanel>

                    <StackPanel x:Name="FooterControls" Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button x:Name="DeathRecapButton" Style="{StaticResource ToolIcon}" Click="DeathRecap_Click">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" StrokeLineJoin="Round" Data="M3,14 V6 C3,0 13,0 13,6 V14 Z M1,14 H15 M8,5 V11 M5.5,7.5 H10.5"/>
                        </Button>
                        <Button x:Name="ChecklistButton" Style="{StaticResource ToolIcon}" Click="Checklist_Click">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" StrokeLineJoin="Round" Data="M1,1 H4 V4 H1 Z M7,2.5 H15 M1,7 H4 V10 H1 Z M7,8.5 H15 M1,13 H4 V16 H1 Z M7,14.5 H15"/>
                        </Button>
                        <Button x:Name="BossRecordsButton" Style="{StaticResource ToolIcon}" Click="PersonalBests_Click" ToolTip="{Binding T.BossPersonalBestsLabel}" AutomationProperties.Name="{Binding T.BossPersonalBestsLabel}">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" StrokeLineJoin="Round" Data="M4,2 H12 V6 C12,8 10,10 8,10 C6,10 4,8 4,6 Z M4,3 H2 V5 C2,7 3,8 5,8 M12,3 H14 V5 C14,7 13,8 11,8 M8,10 V14 M5,14 H11"/>
                        </Button>
                        <Button x:Name="LastPlayedButton" Style="{StaticResource ToolIcon}" Content="&#xE716;" Click="LastPlayedWith_Click" ToolTip="{Binding T.LastPlayedWithLabel}" AutomationProperties.Name="{Binding T.LastPlayedWithLabel}"/>
                        <Button x:Name="CompactHistory" Style="{StaticResource ToolIcon}" Content="&#xE8A5;" Click="Segments_Click" ToolTip="{Binding T.Literal13}"/>
                        <Button x:Name="ChatExportButton" Style="{StaticResource ToolIcon}" Content="&#xE8BD;" Click="Chat_Click" ToolTip="{Binding T.Literal14}"/>
                        <Button x:Name="PatchNotesButton" Style="{StaticResource ToolIcon}" Content="&#xE8A1;" Click="PatchNotes_Click" ToolTip="Patch notes"/>
                        <Button x:Name="SaveLastFightButton" Style="{StaticResource ToolIcon}" Content="&#xE74E;" Click="SaveLastFight_Click" ToolTip="{Binding T.Literal15}" AutomationProperties.Name="{Binding T.Literal15}" />
                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource ToolIcon}" Content="&#xE895;" Click="CheckUpdates_Click" ToolTip="{Binding T.Literal16}" AutomationProperties.Name="{Binding T.Literal16}"/>
                        <!-- Boss timers: always visible, shows the next respawn -->
                        <Button x:Name="BossTimersLink" Style="{StaticResource TimersPill}" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE121;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TimersLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DetailsLink" Style="{StaticResource FooterLink}" Content="{Binding T.OpenFight}" Click="Details_Click" Effect="{StaticResource TextShadow}" />
                        <Button x:Name="HistoryLink" Style="{StaticResource FooterLink}" Click="Segments_Click" Effect="{StaticResource TextShadow}">
                            <TextBlock><Run Text="{Binding T.Fights, Mode=OneWay}" /><Run Text=" " /><Run Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" /></TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Resize grip -->
        <Thumb x:Name="ResizeGrip" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
               Cursor="SizeNWSE" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Path Data="M10 2 L2 10 M10 6 L6 10" Stroke="{DynamicResource CustomBrush_59FFFFFF}" StrokeThickness="1.2" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
    </DockPanel>
    </Border>
</Window>
