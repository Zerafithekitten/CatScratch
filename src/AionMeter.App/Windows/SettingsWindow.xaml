<Window x:Class="AionMeter.App.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:AionMeter.App.Services" Title="{Binding SettingsTitle, Source={x:Static s:UiText.Current}}" Width="760" Height="660" MinWidth="650" MinHeight="420" WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#1B2027" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource UiFont}" Foreground="#EDF2F7" FontSize="12.5">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Theme/MeterPreferences.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Section" TargetType="Border">
        <Setter Property="Background" Value="#171E27" />
        <Setter Property="BorderBrush" Value="#364957" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#A9B8C7" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="24,0,0,6" />
      </Style>
      <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="190" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource MeterComboBox}">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Height" Value="26" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="#202A35" />
        <Setter Property="Foreground" Value="#EDF2F7" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="CaretBrush" Value="#79E3CF" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Width" Value="140" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="#1B2027" CornerRadius="10" BorderBrush="#607B827F" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="20,0,8,0">
        <Image Source="/Assets/app.ico" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBlock Margin="30,0,0,0" Text="{Binding SettingsTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource UiFont}" FontSize="19" Foreground="#79E3CF" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Style="{StaticResource IconButton}" Content="" Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" />
      </Grid>
      <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="14,0,14,0" Background="Transparent" BorderThickness="0" Name="SettingsTabs">
        <TabItem Header="{Binding Literal17, Source={x:Static s:UiText.Current}}" Padding="12,10">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,0,0">
            <StackPanel>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding Literal18, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Literal19, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <TextBox x:Name="WindowWidthText" Width="70" />
                    <TextBlock Text=" × " VerticalAlignment="Center" />
                    <TextBox x:Name="WindowHeightText" Width="70" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Literal20, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <Slider x:Name="WindowOpacityValue" Width="180" Minimum="0.4" Maximum="1" Style="{StaticResource GoldSlider}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Literal21, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding BackgroundOpacity, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <Slider x:Name="OpacityValue" Style="{StaticResource GoldSlider}" Width="180" Minimum="0.15" Maximum="1" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding Literal22, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding RowsShown, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <ComboBox x:Name="MaxRows" MinWidth="80" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding RowSize, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <Slider x:Name="RowSizeValue" Style="{StaticResource GoldSlider}" Width="180" Minimum="50" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="RowSize_Changed" />
                    <TextBlock x:Name="RowSizeText" VerticalAlignment="Center" Margin="10,0,0,0" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="190,2,0,0" Text="{Binding RowSizeHint, Source={x:Static s:UiText.Current}}" />
                  <CheckBox x:Name="CompactModeCheck" Content="{Binding Literal23, Source={x:Static s:UiText.Current}}" Style="{StaticResource DarkCheck}" Margin="0,10,0,0" />
                  <CheckBox x:Name="BarsRelative" Style="{StaticResource DarkCheck}" Content="{Binding BarsRelative, Source={x:Static s:UiText.Current}}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding BarsRelativeHint, Source={x:Static s:UiText.Current}}" />
                  <CheckBox x:Name="ShowGear" Style="{StaticResource DarkCheck}" Margin="0,6,0,0" Content="{Binding Literal24, Source={x:Static s:UiText.Current}}" />
                  <CheckBox x:Name="ShowCombatPower" Style="{StaticResource DarkCheck}" Margin="0,6,0,0" Content="{Binding Literal25, Source={x:Static s:UiText.Current}}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding Literal26, Source={x:Static s:UiText.Current}}" />
                  <CheckBox x:Name="ShowBoss" Style="{StaticResource DarkCheck}" Content="{Binding ShowBossPanel, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding Literal27, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <CheckBox x:Name="AutoShow" Style="{StaticResource DarkCheck}" Margin="0,6,0,0" Content="{Binding AutoShow, Source={x:Static s:UiText.Current}}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding AutoShowHint, Source={x:Static s:UiText.Current}}" />
                  <StackPanel Orientation="Horizontal" Margin="24,0,0,4">
                    <TextBlock Text="{Binding AutoHide, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" Width="250" />
                    <TextBox x:Name="AutoHideSeconds" Width="70" />
                  </StackPanel>
                  <CheckBox x:Name="ShowOnStart" Style="{StaticResource DarkCheck}" Margin="0,6,0,0" Content="{Binding ShowOnStart, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding Literal28, Source={x:Static s:UiText.Current}}" Padding="12,10">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,0,0">
            <StackPanel>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding SecMeter, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Measure, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <ComboBox x:Name="Mode">
                      <ComboBoxItem Content="{Binding MeasureBoss, Source={x:Static s:UiText.Current}}" />
                      <ComboBoxItem Content="{Binding MeasureAll, Source={x:Static s:UiText.Current}}" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding IdleEnd, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <TextBox x:Name="Idle" Width="60" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding IdleBoss, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <TextBox x:Name="BossIdle" Width="60" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding Literal10, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <CheckBox x:Name="ShowPersonalCombatModule" Style="{StaticResource DarkCheck}" Content="{Binding Literal29, Source={x:Static s:UiText.Current}}" />
                  <CheckBox x:Name="ShowHealingDone" Style="{StaticResource DarkCheck}" Content="{Binding Literal31, Source={x:Static s:UiText.Current}}" Margin="0,6,0,0" />
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding Literal32, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding Literal33, Source={x:Static s:UiText.Current}}" Padding="12,10">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,0,0">
            <StackPanel>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding SecHotkeys, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HkToggle, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <TextBox x:Name="HkToggle" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding ToggleAllWindowsLabel, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="HkAll"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding HkReset, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <TextBox x:Name="HkReset" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding HkClick, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <TextBox x:Name="HkClick" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding HkTimers, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <TextBox x:Name="HkTimers" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding TogglePersonalLabel, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}"/><TextBox x:Name="HkPersonal"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding ToggleEventsLabel, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}"/><TextBox x:Name="HkEvents"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding TogglePetsLabel, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}"/><TextBox x:Name="HkPets"/></StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding HotkeysHint, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding Literal34, Source={x:Static s:UiText.Current}}" Padding="12,10">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,0,0">
            <StackPanel>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding SecHistory, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding Literal35, Source={x:Static s:UiText.Current}}" Margin="0,0,0,8" />
                  <Button Style="{StaticResource GhostButton}" Content="{Binding Literal36, Source={x:Static s:UiText.Current}}" Click="DeleteSavedFights_Click" HorizontalAlignment="Left" Margin="0,0,0,8" />
                  <CheckBox x:Name="SaveHistory" Style="{StaticResource DarkCheck}" Content="{Binding SaveAuto, Source={x:Static s:UiText.Current}}" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding WhichFights, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <ComboBox x:Name="HistoryModeBox" MinWidth="250">
                      <ComboBoxItem Content="{Binding HistBosses, Source={x:Static s:UiText.Current}}" />
                      <ComboBoxItem Content="{Binding HistBossesLong, Source={x:Static s:UiText.Current}}" />
                      <ComboBoxItem Content="{Binding HistAll, Source={x:Static s:UiText.Current}}" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding LongerThan, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <TextBox x:Name="HistoryMin" Width="60" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding HistoryHint, Source={x:Static s:UiText.Current}}" />
                  <TextBlock x:Name="HistoryInfo" Style="{StaticResource Hint}" Margin="0,2,0,0" Foreground="{StaticResource TextDim}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding Literal37, Source={x:Static s:UiText.Current}}" Padding="12,10">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,0,0">
            <StackPanel>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding SecCapture, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding NetworkAdapter, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <ComboBox x:Name="Device" MinWidth="300" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,6" Text="{Binding AdapterHint, Source={x:Static s:UiText.Current}}" />
                  <CheckBox x:Name="Record" Style="{StaticResource DarkCheck}" Content="{Binding RecordPackets, Source={x:Static s:UiText.Current}}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding RecordHint, Source={x:Static s:UiText.Current}}" />
                  <CheckBox x:Name="RecentDebug" Style="{StaticResource DarkCheck}" Content="Recent debug buffer (60 seconds / 32 MB, experimental)" Margin="0,8,0,0" />
                  <Button x:Name="SaveRecentDebug" Style="{StaticResource GhostButton}" Content="Save recent debug" Click="SaveRecentDebug_Click" HorizontalAlignment="Left" Margin="0,6,0,0" />
                  <TextBlock x:Name="RecentDebugResult" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                  <TextBlock x:Name="CaptureState" Style="{StaticResource Hint}" Margin="0,6,0,0" Foreground="{StaticResource TextDim}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding SecData, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <CheckBox x:Name="Icons" Style="{StaticResource DarkCheck}" Content="{Binding DownloadIcons, Source={x:Static s:UiText.Current}}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding IconsHint, Source={x:Static s:UiText.Current}}" />
                  <TextBlock x:Name="DataInfo" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,6,0,0" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{Binding OpenDataFolder, Source={x:Static s:UiText.Current}}" Click="OpenData_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{Binding OpenAppFolder, Source={x:Static s:UiText.Current}}" Click="OpenAppData_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{Binding Logs, Source={x:Static s:UiText.Current}}" Click="OpenLogs_Click" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding Literal38, Source={x:Static s:UiText.Current}}" Padding="12,10">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,0,0">
            <StackPanel>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding Literal39, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SettingLanguageLabel, Source={x:Static s:UiText.Current}}" Style="{StaticResource Label}" />
                    <ComboBox x:Name="LanguageBox" MinWidth="160">
                      <ComboBoxItem Content="English" Tag="en" />
                      <ComboBoxItem Content="Deutsch" Tag="de" />
                      <ComboBoxItem Content="Русский" Tag="ru" />
                      <ComboBoxItem Content="Français" Tag="fr" />
                    </ComboBox>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding LanguageHint, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding SecUpdates, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <CheckBox x:Name="CheckUpdates" Style="{StaticResource DarkCheck}" Content="{Binding CheckUpdatesAuto, Source={x:Static s:UiText.Current}}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding UpdatesHint, Source={x:Static s:UiText.Current}}" />
                  <TextBlock Style="{StaticResource Hint}" Text="{Binding Literal40, Source={x:Static s:UiText.Current}}" />
                  <WrapPanel Margin="0,8,0,0">
                    <TextBlock x:Name="VersionText" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,14,0" />
                    <Button x:Name="CheckNowButton" Style="{StaticResource GhostButton}" Click="CheckNow_Click" Content="{Binding CheckNow, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource GhostButton}" Content="Patch notes" Click="PatchNotes_Click" Margin="8,0,0,0" />
                  </WrapPanel>
                  <TextBlock x:Name="UpdateState" Style="{StaticResource Hint}" Margin="0,6,0,0" Foreground="{StaticResource TextDim}" Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <TextBlock Text="{Binding ReportTitle, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                  <TextBlock Text="{Binding ReportHint, Source={x:Static s:UiText.Current}}" Style="{StaticResource Hint}" />
                  <Button x:Name="ReportButton" Style="{StaticResource GhostButton}" Content="{Binding ReportButton, Source={x:Static s:UiText.Current}}" Click="Report_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource GhostButton}" Content="{Binding Cancel, Source={x:Static s:UiText.Current}}" Click="Cancel_Click" Margin="0,0,8,0" />
          <Button Style="{StaticResource PrimaryButton}" Content="{Binding Save, Source={x:Static s:UiText.Current}}" Click="Save_Click" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
